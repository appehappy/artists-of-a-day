# Copy to scripts/deploy.env (git-ignored) and fill in. Read by upload_images.sh and
# deploy_archive.sh.

# Where the images are served from: the R2 bucket's public URL (a custom domain like
# https://images.appppe.com, or its https://pub-….r2.dev address). No trailing slash.
PUBLIC_IMAGE_BASE=https://images.appppe.com

# The rclone remote and bucket the images go to (see `rclone config`: an S3 remote,
# provider Cloudflare, with an R2 API token's access key and secret).
R2_REMOTE=r2
R2_BUCKET=artists-of-a-day

# The Netlify site this deploys to (Site configuration → Site details → Site ID).
NETLIFY_SITE_ID=
