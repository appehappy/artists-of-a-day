# Copy to scripts/deploy.env (git-ignored) and fill in. Read by upload_images.sh and
# deploy_archive.sh.

# Where the images are served from: the Bunny pull zone's address (its b-cdn.net
# hostname, or a custom hostname like https://images.appppe.com). No trailing slash.
PUBLIC_IMAGE_BASE=https://artists-of-a-day.b-cdn.net

# Where upload_images.sh sends them: an rclone S3 remote for the Bunny storage zone
# (README, Hosting) and the zone as its bucket, ending in "/".
IMAGE_DEST=bunny:artists-of-a-day/

# The Netlify site this deploys to (Site configuration → Site details → Site ID).
NETLIFY_SITE_ID=
