<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs the archive refresh daily at 09:00 local time. If the Mac is asleep then,
     launchd runs it on wake. Install:
       cp scripts/launchd/local.aotd-archive.refresh.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/local.aotd-archive.refresh.plist
     Remove:
       launchctl bootout gui/$(id -u)/local.aotd-archive.refresh
       rm ~/Library/LaunchAgents/local.aotd-archive.refresh.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.aotd-archive.refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/brendanappe/Projects/artist-of-the-day-archive/scripts/refresh-daily.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/brendanappe/Projects/artist-of-the-day-archive/data/logs/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/brendanappe/Projects/artist-of-the-day-archive/data/logs/launchd.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
