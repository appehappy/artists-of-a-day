---
import Base from "../layouts/Base.astro";
import { artists, colours, disciplines, regions } from "../lib/data";
import { ERAS } from "../lib/eras";
import shuffleIcon from "../icons/shuffle.svg";
import clearIcon from "../icons/x.svg";
---

<Base>
  <section class="wall-head">
    <p class="summary reveal" style="--i:0">
      <span data-count>…</span> from {artists.length.toLocaleString()} artists featured on{" "}
      <a href="https://visualdiplomacyusa.blogspot.com/" target="_blank" rel="noopener">Artist of the Day</a>
    </p>
    <div class="filters reveal" style="--i:1">
      <div class="chips" data-group="disc" aria-label="Discipline">
        {disciplines.filter((d) => d.key !== "other").map((d) => (
          <button class="chip" type="button" data-value={d.key} aria-pressed="false">{d.label}</button>
        ))}
      </div>
      <div class="chips" data-group="era" aria-label="Era">
        {ERAS.map((e) => (
          <button class="chip" type="button" data-value={e.key} aria-pressed="false">{e.label}</button>
        ))}
      </div>
      <div class="chips" data-group="region" aria-label="Region">
        {regions.filter((r) => r.artists >= 5).map((r) => (
          <button class="chip" type="button" data-value={r.key} aria-pressed="false">{r.key}</button>
        ))}
      </div>
    </div>
  </section>

  <div class="masonry">
    <div class="colour-col reveal" style="--i:2">
      <div class="swatches" data-group="colour" aria-label="Colour">
        {colours.map((c) => (
          <button class="swatch" type="button" data-value={c.key} data-hex={c.hex} aria-pressed="false"
                  aria-label={c.key} title={c.key} style={`--c:${c.hex}`}></button>
        ))}
      </div>
      <div class="wall-actions">
        <button class="icon-btn" type="button" data-reshuffle aria-label="Reshuffle the wall" title="Reshuffle">
          <img src={shuffleIcon.src} width="12" height="12" alt="" />
        </button>
        <button class="icon-btn" type="button" data-clear aria-label="Clear filters" title="Clear filters">
          <img src={clearIcon.src} width="12" height="12" alt="" />
        </button>
      </div>
    </div>
    <div class="wall" id="wall" aria-live="polite"></div>
  </div>
  <div class="wall-end muted" data-sentinel></div>
</Base>

<style>
  /* Chip text (8px in from each chip's edge) lines up with the gutter. */
  .wall-head { padding: 16px calc(var(--gutter) - 8px) 32px; display: grid; gap: 32px; }
  .summary { margin: 0; padding-inline: 8px; font-size: 14px; color: var(--muted); }
  .summary [data-count] { color: var(--ink); }
  .summary a { color: inherit; text-decoration-style: dotted; text-underline-offset: 3px; }
  .summary a:hover { color: var(--ink); }
  .filters { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; } /* rows no wider than the page */
  /* From tablet up each row stays on one line; lib/overflow.ts moves what doesn't fit
     behind a "…" chip whose menu drops below it. */
  @media (min-width: 721px) {
    .filters .chips { flex-wrap: nowrap; }
    .filters .chips > .chip { flex: none; white-space: nowrap; } /* overflow rather than squash */
  }
  .filters :global(.chip-more) { position: relative; flex: none; }
  .filters :global(.chip-more[hidden]) { display: none; }
  .filters :global(.more-btn) { min-width: 36px; justify-content: center; letter-spacing: 0.08em; }
  .filters :global(.more-btn.has-active) { background: var(--pick); color: var(--on-pick); border-color: var(--pick); }
  .filters :global(.chip-menu) {
    position: absolute; top: calc(100% + 6px); right: 0; z-index: 30;
    display: flex; flex-direction: column; align-items: flex-start; gap: 6px;
    padding: 8px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
    opacity: 0; visibility: hidden; transform: translateY(-4px) scale(0.98); transform-origin: top right;
    transition: opacity 0.18s var(--ease), transform 0.25s var(--ease), visibility 0s 0.25s;
  }
  .filters :global(.chip-more.open .chip-menu) {
    opacity: 1; visibility: visible; transform: none;
    transition: opacity 0.18s var(--ease), transform 0.25s var(--ease);
  }
  .filters :global(.chip-menu .chip) { white-space: nowrap; }

  .masonry { display: flex; gap: 32px; align-items: flex-start; padding: 0 var(--gutter) 24px; }
  /* The colour column runs the wall's full height so that, as it scrolls, the swatches
     stay pinned under the header and Reshuffle / Clear to the foot of the window. */
  .colour-col { align-self: stretch; display: flex; flex-direction: column; justify-content: space-between; gap: 24px; }
  /* The swatches are a liquid shape (lib/liquid.ts): joined into one running spectrum,
     the chosen colour standing apart. */
  .swatches {
    position: sticky; top: calc(var(--header-h) + 16px);
    display: flex; flex-direction: column; align-items: flex-start;
    padding: 2px 8px; margin: 0 -8px; /* a wider column to hover and click in */
  }
  .wall-actions { position: sticky; bottom: 24px; display: flex; flex-direction: column; gap: 8px; }
  .icon-btn img { transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .icon-btn.jiggle img { animation: jiggle 0.45s var(--ease); } /* Reshuffle: a shake of the deck */
  @keyframes jiggle { 25% { transform: translateX(-2px) rotate(-8deg); } 60% { transform: translateX(2px) rotate(8deg); } }
  .swatch {
    position: relative; z-index: 1; flex: none;
    width: 24px; height: 24px; border-radius: 50%; border: 1.6px solid transparent;
    background: none; padding: 0; transition: border-color 0.3s var(--ease);
  }
  .swatch[aria-pressed="true"] { border-color: var(--ink); }
  @media (max-width: 720px) {
    .masonry { flex-direction: column; align-items: stretch; gap: 16px; }
    .colour-col { flex-direction: row; flex-wrap: wrap; justify-content: flex-start; gap: 8px; }
    .swatches { position: relative; flex-direction: row; }
    .wall-actions { position: static; flex-direction: row; }
  }

  .wall { flex: 1; min-width: 0; display: flex; gap: 14px; align-items: flex-start; }
  .wall :global(.col) { flex: 1; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .wall :global(.tile) {
    position: relative; display: block; border-radius: 4px; overflow: hidden;
    background: var(--tile); text-decoration: none;
  }
  .wall :global(.tile img) { width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; }
  .wall :global(.tile .cap) {
    position: absolute; inset: auto 0 0 0; padding: 28px 12px 10px; color: #fff;
    background: linear-gradient(transparent, var(--overlay));
    opacity: 0; transform: translateY(6px); transition: all 0.25s var(--ease);
    font-size: 13px; line-height: 1.35;
  }
  .wall :global(.tile .cap b) { display: block; font: 19px/1.15 var(--serif); font-weight: 400; }
  .wall :global(.tile:hover .cap), .wall :global(.tile:focus-visible .cap) { opacity: 1; transform: none; }
  .wall :global(.tile:hover img) { transform: scale(1.025); }
  .wall :global(.tile) { transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease); }
  .wall :global(.tile:hover) { transform: translateY(-3px); box-shadow: 0 12px 30px rgba(0, 0, 0, 0.18); }
  .wall :global(.tile img) { transition: opacity 0.5s var(--ease), transform 0.6s var(--ease); }
  .wall-end { text-align: center; padding: 24px 0 64px; min-height: 40px; }
</style>

<script>
  import { loadArtworks, loadSite, mulberry32, onPage, shuffleInPlace } from "../lib/client";
  import { liquid } from "../lib/liquid";
  import { overflowRow } from "../lib/overflow";
  import { at } from "../lib/paths";
  import { eraOf } from "../lib/eras";
  import { artworkHasColour, thumbUrl, type ArtworkRow, type Post } from "../lib/types";

  const BATCH = 48;
  const luminance = (hex: string) => {
    const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255)
      .map((c) => (c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4));
    return 0.2126 * r + 0.7152 * g + 0.0722 * b;
  };
  const motion = () => !matchMedia("(prefers-reduced-motion: reduce)").matches;
  const KEY = "wall-state";
  let lastNavType: string | null = null;
  document.addEventListener("astro:before-preparation", (e) => {
    lastNavType = (e as unknown as { navigationType: string }).navigationType;
  });

  interface State {
    disc: string[]; era: string | null; region: string | null; colour: string | null;
    seed: number; shown: number; scrollY: number;
  }

  function readState(): State {
    const fresh: State = { disc: [], era: null, region: null, colour: null,
                           seed: (Math.random() * 2 ** 31) | 0, shown: 0, scrollY: 0 };
    try {
      return { ...fresh, ...JSON.parse(sessionStorage.getItem(KEY) || "{}") };
    } catch {
      return fresh;
    }
  }
  const saveState = (s: State) => { try { sessionStorage.setItem(KEY, JSON.stringify(s)); } catch {} };

  onPage("#wall", async (wall) => {
    const restoring = lastNavType === "traverse";
    const state = readState();
    if (!restoring) { state.shown = 0; state.scrollY = 0; }

    // Draw the swatches (with whatever colour was chosen) before the data arrives.
    for (const sw of document.querySelectorAll<HTMLElement>("[data-group=colour] .swatch")) {
      sw.setAttribute("aria-pressed", String(state.colour === sw.dataset.value));
    }
    const swatchCol = document.querySelector<HTMLElement>(".swatches")!;
    const swatches = liquid(swatchCol, [...swatchCol.querySelectorAll<HTMLElement>(".swatch")], {
      axis: getComputedStyle(swatchCol).flexDirection === "row" ? "x" : "y",
      // The goo lets go past ~6.5px: hovered and chosen dots pinch off into clean circles.
      joined: 3, apart: 12, nudge: 9, blur: 4.2, outline: true, intro: !restoring,
      isApart: (el) => el.getAttribute("aria-pressed") === "true",
      fill: (el) => el.dataset.hex!,
    });

    // Filter rows stay on one line (tablet up); what doesn't fit goes behind a "…" chip.
    const chipRows = ([["disc", "disciplines"], ["era", "eras"], ["region", "regions"]] as const)
      .map(([group, label]) => overflowRow(document.querySelector<HTMLElement>(`[data-group="${group}"]`)!, label));

    const [site, rows] = await Promise.all([loadSite(), loadArtworks()]);
    const artistBySlug = new Map(site.artists.map((a) => [a.slug, a]));
    const postMeta = site.posts.map((p: Post) => {
      const a = p.artist ? artistBySlug.get(p.artist) : undefined;
      return { post: p, artist: a, disc: new Set(a?.disciplines ?? []),
               region: a?.region ?? null };
    });
    const colourIndex = new Map(site.colours.map((c, i) => [c.key, i]));

    const countEl = document.querySelector("[data-count]")!;
    const clearBtn = document.querySelector<HTMLButtonElement>("[data-clear]")!;
    const reshuffleBtn = document.querySelector<HTMLButtonElement>("[data-reshuffle]")!;
    const sentinel = document.querySelector<HTMLElement>("[data-sentinel]")!;
    let order: ArtworkRow[] = [];
    let cols: HTMLElement[] = [];
    let heights: number[] = [];
    let tiles: HTMLElement[] = [];

    function syncChips() {
      document.querySelectorAll<HTMLButtonElement>('[data-group="disc"] .chip[data-value]').forEach((b) =>
        b.setAttribute("aria-pressed", String(state.disc.includes(b.dataset.value!))));
      document.querySelectorAll<HTMLButtonElement>('[data-group="era"] .chip[data-value]').forEach((b) =>
        b.setAttribute("aria-pressed", String(state.era === b.dataset.value)));
      for (const group of ["region", "colour"] as const) {
        document.querySelectorAll<HTMLButtonElement>(`[data-group="${group}"] [data-value]`).forEach((b) =>
          b.setAttribute("aria-pressed", String(state[group] === b.dataset.value)));
      }
      tint();
      swatches.retarget();
      for (const r of chipRows) r.sync();
      clearBtn.disabled = !(state.disc.length || state.era || state.region || state.colour);
    }

    // A chosen colour tints the UI: the current nav pill, pressed chips and the search
    // line take it on (see --pick in global.css; <body> is replaced on leaving the Wall,
    // so the tint goes with it).
    function tint() {
      const hex = state.colour ? document.querySelector<HTMLElement>(`[data-hex][data-value="${state.colour}"]`)?.dataset.hex : null;
      const body = document.body.style;
      if (!hex) { for (const v of ["--pick", "--on-pick", "--pick-line"]) body.removeProperty(v); return; }
      body.setProperty("--pick", hex);
      body.setProperty("--pick-line", hex);
      body.setProperty("--on-pick", luminance(hex) > 0.4 ? "#12110f" : "#eeeae2"); // dark text on light colours
    }

    function compute() {
      const disc = new Set(state.disc);
      order = rows.filter((r) => {
        const m = postMeta[r[0]];
        if (disc.size && ![...disc].some((d) => m.disc.has(d))) return false;
        if (state.era && eraOf(r[4]) !== state.era) return false;
        if (state.region && m.region !== state.region) return false;
        if (state.colour && !artworkHasColour(r[6], colourIndex.get(state.colour)!, state.colour)) return false;
        return true;
      });
      shuffleInPlace(order, mulberry32(state.seed));
      countTo(order.length);
    }

    // The works count rolls to its new value.
    let shownCount = 0;
    let countFrame = 0;
    function countTo(n: number) {
      cancelAnimationFrame(countFrame);
      const from = shownCount, start = performance.now();
      const tick = () => {
        const t = motion() ? Math.min(1, (performance.now() - start) / 600) : 1;
        shownCount = Math.round(from + (n - from) * (1 - Math.pow(1 - t, 3)));
        countEl.textContent = `${shownCount.toLocaleString()} works`;
        if (t < 1) countFrame = requestAnimationFrame(tick);
      };
      tick();
    }

    function columnCount() {
      const w = wall.clientWidth;
      return Math.max(2, Math.min(7, Math.floor((w + 14) / 254))); // columns at least 240px, 14px apart
    }

    function layout() {
      wall.replaceChildren();
      const n = columnCount();
      cols = Array.from({ length: n }, () => {
        const c = document.createElement("div");
        c.className = "col";
        wall.appendChild(c);
        return c;
      });
      heights = new Array(n).fill(0);
      for (const t of tiles) place(t);
    }

    function place(tile: HTMLElement) {
      const i = heights.indexOf(Math.min(...heights));
      cols[i].appendChild(tile);
      heights[i] += Number(tile.dataset.ratio) + 0.06;
    }

    function makeTile(r: ArtworkRow): HTMLElement {
      const [pi, file, w, h, year, title] = r;
      const { post, artist } = postMeta[pi];
      const a = document.createElement("a");
      a.className = "tile";
      const art = `?art=${encodeURIComponent(file)}&p=${pi}`;
      a.href = at(artist ? `artist/${artist.slug}` : `post/${post.id}`) + art;
      a.style.aspectRatio = `${w} / ${h}`;
      a.dataset.ratio = String(h / w);
      const img = document.createElement("img");
      img.className = "fade";
      img.loading = "lazy";
      img.decoding = "async";
      img.alt = [title, artist?.name ?? post.subject].filter(Boolean).join(" — ");
      img.src = thumbUrl(post, file);
      img.addEventListener("load", () => img.classList.add("loaded"), { once: true });
      const cap = document.createElement("div");
      cap.className = "cap";
      const b = document.createElement("b");
      b.textContent = artist?.name ?? post.subject ?? "";
      cap.append(b, [title, year].filter(Boolean).join(", "));
      a.append(img, cap);
      a.addEventListener("click", () => {
        img.style.viewTransitionName = "focus-art";
        state.scrollY = window.scrollY;
        saveState(state);
      });
      return a;
    }

    function more(count = BATCH, animate = true) {
      const start = tiles.length;
      order.slice(start, start + count).forEach((r, k) => {
        const t = makeTile(r);
        tiles.push(t);
        place(t);
        // New tiles cascade in, column by column.
        if (animate && motion()) {
          t.animate([{ opacity: 0, transform: "translateY(28px) scale(0.97)" }, { opacity: 1, transform: "none" }],
                    { duration: 650, delay: Math.min(k, 30) * 26, easing: "cubic-bezier(0.2, 0.8, 0.2, 1)", fill: "backwards" });
        }
      });
      state.shown = tiles.length;
      sentinel.textContent = tiles.length >= order.length
        ? (order.length ? "That's everything." : "Nothing matches these filters.") : "";
    }

    // Filter changes: tiles on screen drop away, then the new set rises in.
    let resetToken = 0;
    async function reset() {
      const token = ++resetToken;
      syncChips();
      if (motion() && tiles.length) {
        const onScreen = tiles.filter((t) => {
          const r = t.getBoundingClientRect();
          return r.bottom > 0 && r.top < innerHeight;
        });
        await Promise.all(onScreen.map((t, k) => t.animate(
          [{ opacity: 1, transform: "none" }, { opacity: 0, transform: "translateY(-14px) scale(0.96)" }],
          { duration: 220, delay: Math.min(k, 20) * 8, easing: "ease-in", fill: "forwards" }).finished.catch(() => {})));
        if (token !== resetToken) return; // another filter click arrived meanwhile
      }
      tiles = [];
      compute();
      layout();
      more();
      state.scrollY = 0;
      saveState(state);
    }

    // Filters
    document.querySelectorAll<HTMLButtonElement>('[data-group="disc"] .chip[data-value]').forEach((b) =>
      b.addEventListener("click", () => {
        const v = b.dataset.value!;
        state.disc = state.disc.includes(v) ? state.disc.filter((d) => d !== v) : [...state.disc, v];
        reset();
      }));
    document.querySelectorAll<HTMLButtonElement>('[data-group="era"] .chip[data-value]').forEach((b) =>
      b.addEventListener("click", () => {
        state.era = state.era === b.dataset.value ? null : b.dataset.value!;
        reset();
      }));
    for (const group of ["region", "colour"] as const) {
      document.querySelectorAll<HTMLButtonElement>(`[data-group="${group}"] [data-value]`).forEach((b) =>
        b.addEventListener("click", () => {
          state[group] = state[group] === b.dataset.value ? null : b.dataset.value!;
          reset();
        }));
    }

    reshuffleBtn.addEventListener("click", () => {
      replay(reshuffleBtn, "jiggle");
      state.seed = (Math.random() * 2 ** 31) | 0;
      window.scrollTo({ top: 0, behavior: motion() ? "smooth" : "auto" });
      reset();
    });
    let clearTurns = 0;
    clearBtn.addEventListener("click", () => {
      clearTurns++; // Clear: its × gives a quarter turn
      clearBtn.querySelector("img")!.style.transform = `rotate(${clearTurns * 90}deg)`;
      Object.assign(state, { disc: [], era: null, region: null, colour: null });
      reset();
    });
    function replay(el: HTMLElement, cls: string) {
      el.classList.remove(cls);
      void el.offsetWidth;
      el.classList.add(cls);
    }

    // Initial render, restoring position when coming back
    compute();
    layout();
    more(Math.max(BATCH, restoring ? state.shown : 0), !restoring);
    syncChips();
    if (restoring && state.scrollY) window.scrollTo(0, state.scrollY);
    saveState(state);

    const io = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting && tiles.length < order.length) { more(); saveState(state); }
    }, { rootMargin: "1200px" });
    io.observe(sentinel);

    let resizeTimer = 0;
    const onResize = () => {
      for (const r of chipRows) r.fit();
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => { if (columnCount() !== cols.length) layout(); }, 150);
    };
    window.addEventListener("resize", onResize);
    document.addEventListener("astro:before-swap", () => {
      io.disconnect();
      window.removeEventListener("resize", onResize);
      swatches.destroy();
      for (const r of chipRows) r.destroy();
    }, { once: true });
  });
</script>
