---
// Colour maps made of artworks: pick a shape and a Scientific Colour Map, and the
// archive's closest-matching works fly into place to draw it.
import fs from "node:fs";
import path from "node:path";
import ExploreControls from "../../components/ExploreControls.astro";
import ExploreSwitch from "../../components/ExploreSwitch.astro";
import Base from "../../layouts/Base.astro";
import { cssGradient, SHAPES, type ColourMap } from "../../lib/colourmaps";
import "../../styles/explore.css";
import closeIcon from "../../icons/x.svg";

const mapsFile = path.resolve("public/fields/maps/maps.json");
const data: { credit: string; maps: ColourMap[] } = fs.existsSync(mapsFile)
  ? JSON.parse(fs.readFileSync(mapsFile, "utf8"))
  : { credit: "", maps: [] };
const types = [...new Set(data.maps.map((m) => m.type))];

// Simple outline icons for the shapes.
const icons: Record<string, string> = {
  band: '<rect x="2" y="8" width="20" height="8" rx="1.5"/>',
  ring: '<circle cx="12" cy="12" r="7.5" fill="none" stroke-width="4"/>',
  bowtie: '<path d="M2 5 L12 10 L22 5 V19 L12 14 L2 19 Z"/>',
  steps: '<rect x="1.5" y="7" width="5" height="10" rx="1"/><rect x="9.5" y="7" width="5" height="10" rx="1"/><rect x="17.5" y="7" width="5" height="10" rx="1"/>',
};
---

<Base title="Colour maps">
  <section class="explore" data-maps>
    <canvas class="mosaic-canvas gl" aria-hidden="true"></canvas>
    <canvas class="mosaic-canvas top" aria-label="A colour map drawn with artworks"></canvas>

    <div class="panel window top-left">
      <ExploreSwitch current="maps" />
      <p class="blurb">Pick a shape and a colour map: the archive's closest-matching works fly in to draw it. Zoom in to see each work.</p>
      <p class="hint">Drag to move · pinch or ⌘-scroll to zoom · click a work</p>
    </div>

    <div class="panel window picker">
      <section>
      <h4>Shape</h4>
      <div class="shapes">
        {SHAPES.map((s) => (
          <button type="button" data-shape={s.key} aria-pressed="false" title={`${s.label} · suits ${s.suits.toLowerCase()} maps`}>
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[s.key]} />
            <span>{s.label}</span>
          </button>
        ))}
      </div>
      </section>
      {types.map((type) => (
        <section>
          <h4>{type}</h4>
          <div class="maps">
            {data.maps.filter((m) => m.type === type).map((m) => (
              <button type="button" data-map={m.name} aria-pressed="false" title={m.name}>
                <span class="swatch" style={`background:${cssGradient(m)}`}></span>
                <span class="name">{m.name}</span>
              </button>
            ))}
          </div>
        </section>
      ))}
      <label class="amount">
        <span>Works <output data-amount-label>6,000</output></span>
        <input type="range" min="1000" max="20000" step="500" value="6000" data-amount />
      </label>
      <p class="readout" data-readout>…</p>
      <a class="credit" href={`https://doi.org/${data.credit.match(/doi:([^)\s]+)/)?.[1] ?? "10.5281/zenodo.1243862"}`}
         target="_blank" rel="noopener">{data.credit.replace(/ \(doi.*\)/, "")}</a>
    </div>

    <ExploreControls fitLabel="Whole shape" />

    <div class="loading" data-loading>{data.maps.length ? "Gathering 89,000 works…" : "Colour map data isn't built yet. Run scripts/build_colourmaps.py."}</div>
    <div class="tip" hidden></div>

    <aside class="card window" aria-live="polite" hidden>
      <header class="window-head">
        <div>
          <p class="window-eyebrow card-dates"></p>
          <h2 class="window-title"><a class="card-artist" href="#"></a></h2>
        </div>
        <button type="button" class="icon-btn card-close" aria-label="Close">
          <img src={closeIcon.src} width="12" height="12" alt="" />
        </button>
      </header>
      <div class="card-img"><img alt="" /></div>
      <p class="card-meta"></p>
      <a class="card-open" href="#">Open artist page<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3.33 8h9.34M8 12.67 12.67 8 8 3.33" /></svg></a>
    </aside>
  </section>
</Base>

<style>
  .top { z-index: 1; }
  /* The picker: sections of a heading and its options, 16px apart. */
  .picker {
    top: 16px; right: 16px; bottom: 16px; width: 300px; overflow-y: auto; z-index: 2;
    display: flex; flex-direction: column; gap: 16px;
  }
  .picker section { display: grid; gap: 12px; }
  .picker h4 { margin: 0; font: 500 10px/1 var(--sans); letter-spacing: 1.2px; text-transform: uppercase; color: var(--muted); }
  /* Shapes: square segments butted together, the chosen one in ink. */
  .shapes { display: flex; }
  .shapes button {
    flex: 1 1 0; min-width: 0; height: 66px; margin-right: -1px;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
    border: 1px solid transparent; border-radius: 0; background: var(--surface); color: var(--muted);
    font-size: 11px; line-height: 1.5; transition: color 0.2s var(--ease), background-color 0.25s var(--ease);
  }
  .shapes button:last-child { margin-right: 0; }
  .shapes svg { width: 24px; height: 24px; fill: currentColor; stroke: currentColor; }
  .shapes button:hover { color: var(--ink); }
  .shapes button[aria-pressed="true"] { position: relative; background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .maps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px 5.5px; }
  .maps button {
    display: grid; gap: 5px; border: 0; background: none; padding: 0; text-align: left;
    color: var(--muted); font-size: 10px; line-height: 12px; transition: color 0.2s var(--ease);
  }
  .maps .swatch { display: block; height: 18px; transition: transform 0.2s var(--ease), box-shadow 0.2s; }
  .maps button:hover { color: var(--ink); }
  .maps button:hover .swatch { transform: scaleY(1.15); }
  .maps button[aria-pressed="true"] { color: var(--ink); }
  .maps button[aria-pressed="true"] .swatch { box-shadow: 0 0 0 2px var(--bg), 0 0 0 3.5px var(--ink); }
  /* Works: a label and value, then a slim slider whose filled part is ink. */
  .amount { display: grid; gap: 16px; font-size: 12px; line-height: 1.5; color: var(--ink); }
  .amount output { font-size: 13px; font-weight: 500; margin-left: 6px; }
  .amount input {
    -webkit-appearance: none; appearance: none; width: 100%; height: 16px; margin: 0; background: none; cursor: pointer;
    --fill: linear-gradient(var(--ink), var(--ink)) 0 / var(--pct, 25%) 100% no-repeat, var(--line);
  }
  .amount input::-webkit-slider-runnable-track { height: 4px; border-radius: 2px; background: var(--fill); }
  .amount input::-moz-range-track { height: 4px; border-radius: 2px; background: var(--fill); }
  .amount input::-webkit-slider-thumb {
    -webkit-appearance: none; width: 16px; height: 16px; margin-top: -6px; border: 0; border-radius: 50%; background: var(--ink);
    transition: transform 0.2s var(--ease);
  }
  .amount input::-moz-range-thumb { width: 16px; height: 16px; border: 0; border-radius: 50%; background: var(--ink); }
  .amount input:active::-webkit-slider-thumb { transform: scale(1.15); }
  .readout { margin: 0; font-size: 12px; line-height: 1.5; color: var(--muted); }
  .credit { margin-top: 12px; font-size: 11px; line-height: 1.5; color: var(--muted); }
  .credit:hover { color: var(--ink); }
  .card { z-index: 4; }
  @media (max-width: 720px) {
    .picker { top: auto; left: 16px; width: auto; height: 42%; }
  }
</style>

<script>
  import { loadArtworks, loadSite, onPage } from "../../lib/client";
  import { makeShape, match, SHAPES, type ColourMap, type Match, type ShapeKey } from "../../lib/colourmaps";
  import { loadMosaicData, MosaicView } from "../../lib/mosaic";
  import { at } from "../../lib/paths";
  import { imgUrl, lifeDates, thumbUrl } from "../../lib/types";

  let view: MosaicView | null = null;
  document.addEventListener("astro:before-swap", () => { view?.destroy(); view = null; });

  onPage("[data-maps]", async (root) => {
    const loading = root.querySelector<HTMLElement>("[data-loading]")!;
    let site, rows, data, maps: ColourMap[];
    try {
      [site, rows, data, maps] = await Promise.all([
        loadSite(), loadArtworks(), loadMosaicData(),
        fetch(at("fields/maps/maps.json")).then((r) => { if (!r.ok) throw new Error(); return r.json(); }).then((d) => d.maps),
      ]);
    } catch {
      loading.textContent = "Colour map data isn't built yet. Run scripts/build_colourmaps.py, then reload.";
      return;
    }
    const { atlas, uvs, lab } = data;

    const bySlug = new Map(site.artists.map((a) => [a.slug, a]));
    const describe = (row: number) => {
      const [pi, file, , , year, title] = rows[row];
      const post = site.posts[pi];
      const artist = post.artist ? bySlug.get(post.artist) : undefined;
      const href = `${at(artist ? `artist/${artist.slug}` : `post/${post.id}`)}?art=${encodeURIComponent(file)}`;
      return { post, file, artist, href, name: artist?.name ?? post.subject ?? "",
               work: [title, year].filter(Boolean).join(", ") };
    };

    const tip = root.querySelector<HTMLElement>(".tip")!;
    const card = root.querySelector<HTMLElement>(".card")!;
    const cardImg = card.querySelector<HTMLImageElement>(".card-img img")!;
    const select = (row: number | null) => {
      if (row === null) { card.hidden = true; return; }
      const d = describe(row);
      cardImg.src = thumbUrl(d.post, d.file);
      const full = new Image();
      full.onload = () => { if (cardImg.dataset.row === String(row)) cardImg.src = full.src; };
      full.src = imgUrl(d.post, d.file);
      cardImg.dataset.row = String(row);
      const nameEl = card.querySelector<HTMLAnchorElement>(".card-artist")!;
      nameEl.textContent = d.name;
      nameEl.href = d.href;
      card.querySelector(".card-dates")!.textContent = d.artist ? lifeDates(d.artist) : "";
      card.querySelector(".card-meta")!.textContent =
        [d.work || "Untitled", d.artist?.nationality, d.artist?.region].filter(Boolean).join(" · ");
      card.querySelector<HTMLAnchorElement>(".card-open")!.href = d.href;
      card.hidden = false;
    };

    try {
      view = new MosaicView(root.querySelector(".gl")!, root.querySelector(".top")!, data.base, atlas, uvs, {
        thumbUrl: (row) => thumbUrl(site.posts[rows[row][0]], rows[row][1]),
        onHover: (row, x, y) => {
          if (row === null) { tip.hidden = true; return; }
          const d = describe(row);
          tip.replaceChildren();
          const b = document.createElement("b");
          b.textContent = d.name;
          tip.append(b, d.work);
          tip.hidden = false;
          tip.style.left = `${Math.min(x + 14, root.clientWidth - 270)}px`;
          tip.style.top = `${y + 16}px`;
        },
        onSelect: select,
      });
    } catch {
      loading.textContent = "This view needs WebGL2, which this browser doesn't offer.";
      return;
    }

    // Keep the shape clear of the info panel and the picker on wide screens.
    const info = root.querySelector<HTMLElement>(".top-left")!;
    const picker = root.querySelector<HTMLElement>(".picker")!;
    const syncInset = () => {
      const wide = innerWidth > 720;
      view!.insetRight = wide ? picker.offsetWidth + 32 : 0;
      const bottom = info.getBoundingClientRect().bottom - root.querySelector(".gl")!.getBoundingClientRect().top;
      view!.setInsetLeft(wide ? info.offsetWidth + 24 : 0, bottom); // refits
    };
    syncInset();
    addEventListener("resize", syncInset);
    document.addEventListener("astro:before-swap", () => removeEventListener("resize", syncInset), { once: true });

    // State lives in the URL so a combination can be shared.
    const params = new URLSearchParams(location.search);
    const state = {
      map: maps.some((m) => m.name === params.get("map")) ? params.get("map")! : "batlow",
      shape: (SHAPES.some((s) => s.key === params.get("shape")) ? params.get("shape") : "band") as ShapeKey,
      n: Math.min(20000, Math.max(1000, Number(params.get("n")) || 6000)),
    };
    const amount = root.querySelector<HTMLInputElement>("[data-amount]")!;
    const amountLabel = root.querySelector("[data-amount-label]")!;
    amount.value = String(state.n);
    // The slider's filled part runs up to the thumb.
    const fillSlider = () => amount.style.setProperty("--pct",
      `${((Number(amount.value) - Number(amount.min)) / (Number(amount.max) - Number(amount.min))) * 100}%`);
    fillSlider();

    // Matching takes up to a second, so it runs in a worker and the page stays
    // responsive (on the main thread if workers aren't available).
    let worker: Worker | null = null;
    try {
      worker = new Worker(new URL("../../lib/matcher.worker.ts", import.meta.url), { type: "module" });
      worker.postMessage({ lab });
      document.addEventListener("astro:before-swap", () => worker?.terminate(), { once: true });
    } catch { worker = null; }
    let latest = 0;
    const matchFor = (id: number, map: ColourMap, slots: ReturnType<typeof makeShape>) => new Promise<Match>((resolve) => {
      if (!worker) { resolve(match(lab, map, slots)); return; }
      const w = worker;
      const reply = (e: MessageEvent<Match & { id: number }>) => {
        if (e.data.id !== id) return;
        w.removeEventListener("message", reply);
        resolve(e.data);
      };
      w.addEventListener("message", reply);
      w.postMessage({ id, map, slots });
    });

    let first = true;
    const apply = async () => {
      const t0 = performance.now();
      const id = ++latest;
      const map = maps.find((m) => m.name === state.map)!;
      const slots = makeShape(state.shape, state.n);
      root.querySelectorAll<HTMLButtonElement>("[data-shape]").forEach((b) =>
        b.setAttribute("aria-pressed", String(b.dataset.shape === state.shape)));
      root.querySelectorAll<HTMLButtonElement>("[data-map]").forEach((b) =>
        b.setAttribute("aria-pressed", String(b.dataset.map === state.map)));
      amountLabel.textContent = slots.n.toLocaleString();
      history.replaceState(history.state, "", `?map=${state.map}&shape=${state.shape}&n=${state.n}`);
      const m = await matchFor(id, map, slots);
      if (id !== latest) return; // a newer choice is on its way
      // The shape draws itself along the gradient: slowly the first time, in colour
      // until the images arrive, with the map filling in beneath as a loading bar.
      view!.setLayout({ rows: m.rows, x: slots.x, y: slots.y, t: slots.t, slotRgb: m.slotRgb,
                        enter: "trail", gradient: map.stops, stagger: first ? 2200 : undefined },
                      { animateIn: first });
      first = false;
      card.hidden = true;
      root.querySelector("[data-readout]")!.textContent =
        `${state.map} · ${slots.n.toLocaleString()} works · average colour distance ${m.distance.toFixed(3)} · arranged in ${Math.round(performance.now() - t0)} ms`;
    };

    root.querySelectorAll<HTMLButtonElement>("[data-shape]").forEach((b) =>
      b.addEventListener("click", () => { state.shape = b.dataset.shape as ShapeKey; apply(); }));
    root.querySelectorAll<HTMLButtonElement>("[data-map]").forEach((b) =>
      b.addEventListener("click", () => { state.map = b.dataset.map!; apply(); }));
    amount.addEventListener("input", () => { amountLabel.textContent = Number(amount.value).toLocaleString(); fillSlider(); });
    amount.addEventListener("change", () => { state.n = Number(amount.value); apply(); });
    root.querySelectorAll<HTMLButtonElement>("[data-zoom]").forEach((b) =>
      b.addEventListener("click", () => view!.flyTo({ s: view!.cam.s * Number(b.dataset.zoom) }, 350)));
    root.querySelector("[data-fit]")!.addEventListener("click", () => view!.fit());
    root.querySelector("[data-surprise]")!.addEventListener("click", () => {
      const row = view!.randomRow();
      if (row === null) return;
      view!.selected = row;
      view!.flyToRow(row, 160);
      select(row);
    });
    card.querySelector(".card-close")!.addEventListener("click", () => {
      card.hidden = true;
      view!.selected = null;
      view!.invalidate();
    });

    await apply();
    loading.classList.add("done");
  });
</script>
