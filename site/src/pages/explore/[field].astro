---
import ExploreSwitch from "../../components/ExploreSwitch.astro";
import Base from "../../layouts/Base.astro";
import "../../styles/explore.css";

export function getStaticPaths() {
  return [
    { params: { field: "colour" }, props: {
      title: "Colour Field",
      blurb: "A colour wheel of every artwork: hue around the circle, more vivid towards the edge, greys at the centre.",
      modes: {
        wheel: "A colour wheel of every artwork: hue around the circle, more vivid towards the edge, greys at the centre.",
        vivid: "The most colourful quarter of the archive as a colour wheel.",
        orbits: "After Alma Thomas: the archive's most saturated works in rings of colour around a dark sun.",
      },
    } },
    { params: { field: "constellation" }, props: {
      title: "Constellation",
      blurb: "An archipelago of visual likeness: each island gathers works that look alike, whoever made them. Zoom in for the regions within.",
      modes: null,
    } },
  ];
}

const { field } = Astro.params;
const { title, blurb, modes } = Astro.props;
---

<Base title={title}>
  <section class="explore" data-field={field}>
    <canvas class="field-canvas" aria-label={`${title}: a zoomable mosaic of every artwork`}></canvas>
    {modes && (
      <>
        <canvas class="mosaic-canvas gl" aria-hidden="true" hidden></canvas>
        <canvas class="mosaic-canvas top" aria-label="Orbits of saturated artworks" hidden></canvas>
      </>
    )}

    <div class="panel top-left">
      <ExploreSwitch current={field} />
      <p class="blurb" data-blurb>{blurb}</p>
      {modes && (
        <div class="modes" role="group" aria-label="Arrangement" data-modes={JSON.stringify(modes)}>
          <button type="button" data-mode="wheel" aria-pressed="true">Wheel</button>
          <button type="button" data-mode="vivid" aria-pressed="false">Vivid</button>
          <button type="button" data-mode="orbits" aria-pressed="false">Orbits</button>
        </div>
      )}
      <p class="hint">Drag to move · pinch or ⌘-scroll to zoom · click a work</p>
    </div>

    <div class="panel bottom-left controls">
      <button type="button" data-zoom="1.8" aria-label="Zoom in">+</button>
      <button type="button" data-zoom="0.55" aria-label="Zoom out">−</button>
      <button type="button" data-fit>Whole field</button>
      <button type="button" data-surprise>Surprise me</button>
    </div>

    <div class="loading" data-loading>Laying out 89,000 works…</div>
    <div class="tip" hidden></div>

    <aside class="card" aria-live="polite" hidden>
      <button type="button" class="card-close" aria-label="Close">×</button>
      <div class="card-img"><img alt="" /></div>
      <a class="card-artist serif" href="#"></a>
      <p class="card-meta"></p>
      <a class="card-open" href="#">Open artist page →</a>
      <h3>More like this</h3>
      <div class="card-similar"></div>
    </aside>
  </section>
</Base>


<script>
  import { loadArtworks, loadSite, onPage } from "../../lib/client";
  import { FieldView, loadField } from "../../lib/field";
  import { loadMosaicData, MosaicView } from "../../lib/mosaic";
  import { orbitLayout } from "../../lib/orbits";
  import { imgUrl, thumbUrl, type SimilarMap } from "../../lib/types";

  type View = FieldView | MosaicView;
  type Mode = "wheel" | "vivid" | "orbits";
  const ORBIT_WORKS = 1800;

  let view: View | null = null;
  document.addEventListener("astro:before-swap", () => { view?.destroy(); view = null; });

  onPage("[data-field]", async (root) => {
    const field = root.dataset.field!;
    const modesEl = root.querySelector<HTMLElement>("[data-modes]");
    const blurbs: Record<Mode, string> | null = modesEl ? JSON.parse(modesEl.dataset.modes!) : null;
    const params = new URLSearchParams(location.search);
    let mode: Mode = !modesEl ? "wheel"
      : params.get("mode") === "orbits" ? "orbits" : params.has("vivid") || params.get("mode") === "vivid" ? "vivid" : "wheel";
    const loading = root.querySelector<HTMLElement>("[data-loading]")!;
    let site, rows;
    try {
      [site, rows] = await Promise.all([loadSite(), loadArtworks()]);
    } catch {
      loading.textContent = "This view's data isn't built yet. Run scripts/build_fields.py, then reload.";
      return;
    }
    const bySlug = new Map(site.artists.map((a) => [a.slug, a]));
    const rowByKey = new Map(rows.map((r, i) => [`${r[0]}|${r[1]}`, i]));
    const thumb = (row: number) => thumbUrl(site.posts[rows[row][0]], rows[row][1]);
    const describe = (row: number) => {
      const [pi, , , , year, title] = rows[row];
      const post = site.posts[pi];
      const artist = post.artist ? bySlug.get(post.artist) : undefined;
      return { post, artist, name: artist?.name ?? post.subject ?? "", work: [title, year].filter(Boolean).join(", ") };
    };

    const tip = root.querySelector<HTMLElement>(".tip")!;
    const card = root.querySelector<HTMLElement>(".card")!;
    const cardImg = card.querySelector<HTMLImageElement>(".card-img img")!;
    const similarCache = new Map<number, Promise<SimilarMap>>();

    const select = async (row: number | null) => {
      if (row === null) { card.hidden = true; return; }
      const { post, artist, name: who, work } = describe(row);
      const [pi, file] = rows[row];
      const href = `${artist ? `/artist/${artist.slug}` : `/post/${post.id}`}?art=${encodeURIComponent(file)}`;
      cardImg.src = thumb(row);
      const full = new Image();
      full.onload = () => { if (cardImg.dataset.row === String(row)) cardImg.src = full.src; };
      full.src = imgUrl(post, file);
      cardImg.dataset.row = String(row);
      const nameEl = card.querySelector<HTMLAnchorElement>(".card-artist")!;
      nameEl.textContent = who;
      nameEl.href = href;
      card.querySelector(".card-meta")!.textContent =
        [work || "Untitled", artist?.nationality, artist?.region].filter(Boolean).join(" · ");
      card.querySelector<HTMLAnchorElement>(".card-open")!.href = href;
      card.hidden = false;

      if (!similarCache.has(pi)) {
        similarCache.set(pi, fetch(`/data/similar/${pi}.json`).then((r) => (r.ok ? r.json() : {})).catch(() => ({})));
      }
      const similar = (await similarCache.get(pi)!)[file] ?? [];
      if (cardImg.dataset.row !== String(row)) return;
      const box = card.querySelector(".card-similar")!;
      box.replaceChildren(...similar.map(([spi, sfile]) => rowByKey.get(`${spi}|${sfile}`))
        .filter((r): r is number => r !== undefined)
        .map((r) => {
          const b = document.createElement("button");
          b.type = "button";
          b.title = describe(r).name;
          const img = document.createElement("img");
          img.src = thumb(r);
          img.alt = describe(r).name;
          b.append(img);
          // Hop across the field to the similar work (if it's in this arrangement).
          b.addEventListener("click", () => {
            view!.selected = r;
            view!.flyToRow(r, Math.max(view!.cam.s, 120));
            select(r);
          });
          return b;
        }));
    };

    const handlers = {
      thumbUrl: thumb,
      onHover: (row: number | null, x: number, y: number) => {
        if (row === null) { tip.hidden = true; return; }
        const { name: who, work } = describe(row);
        tip.innerHTML = "";
        const b = document.createElement("b");
        b.textContent = who;
        tip.append(b, work);
        tip.hidden = false;
        tip.style.left = `${Math.min(x + 14, root.clientWidth - 270)}px`;
        tip.style.top = `${y + 16}px`;
      },
      onSelect: select,
    };

    // Keep the fitted field clear of the info panel on wide screens.
    const panel = root.querySelector<HTMLElement>(".top-left")!;
    const inset = () => (innerWidth > 720 ? panel.offsetWidth + 24 : 0);
    const syncInset = () => view?.setInsetLeft(inset());
    addEventListener("resize", syncInset);
    document.addEventListener("astro:before-swap", () => removeEventListener("resize", syncInset), { once: true });

    const fieldCanvas = root.querySelector<HTMLCanvasElement>(".field-canvas")!;
    const glCanvas = root.querySelector<HTMLCanvasElement>(".gl");
    const topCanvas = root.querySelector<HTMLCanvasElement>(".top");
    const canvasesFor = (m: Mode) => (m === "orbits" ? [glCanvas!, topCanvas!] : [fieldCanvas]);
    let mosaicData: ReturnType<typeof loadMosaicData> | null = null;

    /** Build the view for a mode on its canvas(es). */
    const build = async (m: Mode): Promise<View> => {
      if (m === "orbits") {
        mosaicData ??= loadMosaicData();
        const d = await mosaicData;
        const v = new MosaicView(glCanvas!, topCanvas!, d.base, d.atlas, d.uvs, handlers);
        v.setInsetLeft(inset());
        v.setLayout(orbitLayout(d.lab, { count: ORBIT_WORKS }), { animateIn: true });
        return v;
      }
      const f = await loadField(m === "vivid" ? "colour-vivid" : field);
      const v = new FieldView(fieldCanvas, f.base, f.layout, f.cells, f.overview, f.smooth, handlers);
      v.setInsetLeft(inset());
      return v;
    };

    const showMode = (m: Mode) => {
      for (const c of [fieldCanvas, glCanvas, topCanvas]) if (c) c.hidden = !canvasesFor(m).includes(c);
      root.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach((b) =>
        b.setAttribute("aria-pressed", String(b.dataset.mode === m)));
      if (blurbs) root.querySelector("[data-blurb]")!.textContent = blurbs[m];
    };

    try {
      showMode(mode);
      view = await build(mode);
    } catch {
      loading.textContent = mode === "orbits"
        ? "Orbits needs scripts/build_colourmaps.py and WebGL2."
        : "This view's data isn't built yet. Run scripts/build_fields.py, then reload.";
      return;
    }
    loading.classList.add("done");

    // Switch arrangements with a crossfade.
    root.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach((btn) => btn.addEventListener("click", async () => {
      const next = btn.dataset.mode as Mode;
      if (next === mode) return;
      const prev = mode;
      mode = next;
      history.replaceState(history.state, "", next === "wheel" ? location.pathname : `?mode=${next}`);
      const motion = !matchMedia("(prefers-reduced-motion: reduce)").matches;
      const fades = motion ? canvasesFor(prev).map((c) => c.animate([{ opacity: 1 }, { opacity: 0 }],
                                                                  { duration: 200, fill: "forwards" })) : [];
      await Promise.all(fades.map((f) => f.finished));
      view?.destroy();
      card.hidden = true;
      showMode(next);
      view = await build(next);
      fades.forEach((f) => f.cancel()); // drop the held opacity: 0
      if (motion && next !== "orbits") { // orbits make their own entrance
        fieldCanvas.animate([{ opacity: 0, transform: "scale(0.97)" }, { opacity: 1, transform: "none" }],
                            { duration: 450, easing: "cubic-bezier(0.2, 0.8, 0.2, 1)" });
      }
    }));

    root.querySelectorAll<HTMLButtonElement>("[data-zoom]").forEach((b) =>
      b.addEventListener("click", () => view!.flyTo({ s: view!.cam.s * Number(b.dataset.zoom) }, 350)));
    root.querySelector("[data-fit]")!.addEventListener("click", () => view!.fit());
    root.querySelector("[data-surprise]")!.addEventListener("click", () => {
      const row = view!.randomRow();
      if (row === null) return;
      view!.selected = row;
      view!.flyToRow(row, 180);
      select(row);
    });
    card.querySelector(".card-close")!.addEventListener("click", () => {
      card.hidden = true;
      view!.selected = null;
      view!.invalidate();
    });
  });
</script>
