---
// Large lead image at the top of artist and post pages. Shows the intro collage by
// default; Base.astro swaps in the artwork clicked on the Wall (?art=<file>) and
// morphs it into place.
interface Props {
  src: string | null;
}
const { src } = Astro.props;
---

<figure class="feature" data-feature>
  {src && <img src={src} data-default-src={src} alt="" />}
  <figcaption class="muted"></figcaption>
</figure>

<style>
  .feature { margin: 0; position: sticky; top: 90px; }
  .feature img {
    width: 100%; max-height: 74vh; object-fit: contain; object-position: left top;
    border-radius: 4px;
  }
  .feature figcaption { margin-top: 10px; font-size: 13px; min-height: 1em; }
  @media (max-width: 900px) { .feature { position: static; } }
</style>
