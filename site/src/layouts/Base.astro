---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { at, route } from "../lib/paths";

interface Props {
  title?: string;
}
const { title } = Astro.props;
const path = route(Astro.url.pathname);
const nav = [
  { href: at(""), label: "Wall", match: (p: string) => p === "/" },
  { href: at("explore/colour"), label: "Explore", match: (p: string) => p.startsWith("/explore") },
  { href: at("today"), label: "On this day", match: (p: string) => p === "/today" },
];

// Page changes: the old page drifts up and fades, the new one rises into place.
const pageMotion = {
  forwards: {
    old: { name: "page-out", duration: "0.22s", easing: "cubic-bezier(0.4, 0, 1, 1)", fillMode: "both" },
    new: { name: "page-in", duration: "0.42s", delay: "0.06s", easing: "cubic-bezier(0.2, 0.8, 0.2, 1)", fillMode: "both" },
  },
  backwards: {
    old: { name: "page-out-back", duration: "0.22s", easing: "cubic-bezier(0.4, 0, 1, 1)", fillMode: "both" },
    new: { name: "page-in-back", duration: "0.42s", delay: "0.06s", easing: "cubic-bezier(0.2, 0.8, 0.2, 1)", fillMode: "both" },
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · Artist of the Day Archive` : "Artist of the Day Archive"}</title>
    <link rel="icon" href={at("favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={at("apple-touch-icon.png")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Imbue:opsz,wght@10..100,100..900&family=Google+Sans:wght@300..700&display=swap"
    />
    <ClientRouter />
  </head>
  <body>
    <header class="site-header" transition:persist="site-header" transition:animate="none">
      <div class="header-left">
        <a class="wordmark" href={at("")} aria-label="Artists of a Day">
          <!-- AoaD: A, o, a, D on a 40-unit grid, one baseline (Figma: "AoaD wordmark") -->
          <svg viewBox="0 0 148 40" aria-hidden="true">
            <path d="M40 0V40H0Z" />
            <circle class="wordmark-o" cx="60" cy="28" r="12" />
            <path d="M100 16V40H76Z" />
            <path d="M108 0H128C139.046 0 148 8.954 148 20C148 31.046 139.046 40 128 40H108Z" />
          </svg>
        </a>
        <nav class="site-nav">
          {nav.map((n, i) => (
            <a href={n.href} style={`--i:${i}`} aria-current={n.match(path) ? "page" : undefined}>{n.label}</a>
          ))}
          <button type="button" style={`--i:${nav.length}`} data-shuffle>Shuffle</button>
        </nav>
      </div>
      <div class="search">
        <input type="search" placeholder="Search 2,300+ artists" aria-label="Search artists" autocomplete="off" />
        <ul hidden></ul>
      </div>
    </header>
    <main transition:animate={pageMotion}>
      <slot />
    </main>

    <script>
      import { navigate } from "astro:transitions/client";
      import { loadSite } from "../lib/client";
      import { mountNav } from "../lib/nav";
      import { at } from "../lib/paths";

      const fold = (s: string) => s.normalize("NFKD").replace(/[̀-ͯ]/g, "").toLowerCase();
      const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

      // Lead image: show the artwork the visitor clicked (?art=<file>) and give it the
      // same view-transition-name as the Wall tile so it morphs into place. This runs
      // on after-swap, inside the transition, so it must live here rather than in
      // the page's own script (which hasn't loaded yet on a first visit).
      function applyFeature() {
        const fig = document.querySelector<HTMLElement>("[data-feature]");
        const file = new URLSearchParams(location.search).get("art");
        if (!fig || !file) return;
        const item = document.querySelector<HTMLElement>(`[data-file="${CSS.escape(file)}"]`);
        if (!item) return;
        let img = fig.querySelector("img");
        if (!img) { img = document.createElement("img"); fig.prepend(img); }
        img.src = item.dataset.src!;
        img.style.viewTransitionName = "focus-art";
        fig.querySelector("figcaption")!.textContent = item.dataset.caption || "";
      }
      document.addEventListener("astro:after-swap", applyFeature);

      document.addEventListener("astro:page-load", () => {
        applyFeature();
        document.querySelectorAll<HTMLImageElement>("img.fade:not(.loaded)").forEach((img) => {
          if (img.complete && img.naturalWidth) img.classList.add("loaded");
          else img.addEventListener("load", () => img.classList.add("loaded"), { once: true });
        });

        // The header persists across page changes (so the nav pill can glide to the
        // new page); bind it once.
        const header = document.querySelector<HTMLElement>(".site-header")!;
        mountNav(header.querySelector(".site-nav")!);
        if (header.dataset.bound) return;
        header.dataset.bound = "1";

        const input = document.querySelector<HTMLInputElement>(".search input")!;
        const list = document.querySelector<HTMLUListElement>(".search ul")!;
        let active = -1;

        const render = async () => {
          const q = fold(input.value.trim());
          if (q.length < 2) { list.hidden = true; return; }
          const { artists } = await loadSite();
          const hits = artists
            .map((a) => ({ a, n: fold(a.name) }))
            .filter(({ n }) => n.split(/[\s-]+/).some((w) => w.startsWith(q)) || n.includes(q))
            .sort((x, y) => Number(!x.n.startsWith(q)) - Number(!y.n.startsWith(q)))
            .slice(0, 10);
          active = -1;
          list.innerHTML = hits.length
            ? hits.map(({ a }) => `<li><a href="${at(`artist/${a.slug}`)}">${esc(a.name)}<small>${esc([a.nationality, a.roles.slice(0, 2).join(", ")].filter(Boolean).join(" · "))}</small></a></li>`).join("")
            : `<li class="muted" style="padding:8px 10px">No artists match</li>`;
          list.hidden = false;
        };

        input.addEventListener("input", render);
        input.addEventListener("focus", () => { loadSite(); render(); });
        input.addEventListener("blur", () => setTimeout(() => (list.hidden = true), 150));
        input.addEventListener("keydown", (e) => {
          const links = [...list.querySelectorAll("a")];
          if (e.key === "ArrowDown" || e.key === "ArrowUp") {
            e.preventDefault();
            active = (active + (e.key === "ArrowDown" ? 1 : -1) + links.length) % links.length;
            links.forEach((l, i) => l.classList.toggle("active", i === active));
          } else if (e.key === "Enter" && links.length) {
            navigate(links[Math.max(active, 0)].getAttribute("href")!);
          } else if (e.key === "Escape") {
            list.hidden = true;
          }
        });
      });
    </script>
  </body>
</html>
